<?php

declare(strict_types=1);

function admin_shop_save_product_image_order(PDO $db, int $actorUserId, int $productId, array $submittedPositions): int
{
    if ($productId < 1) {
        throw new InvalidArgumentException('A valid product is required.');
    }

    $product = admin_shop_product($db, $productId);
    if (!$product) {
        throw new InvalidArgumentException('Product not found.');
    }

    $stmt = $db->prepare(
        'SELECT id, is_primary, sort_order
         FROM shop_product_images
         WHERE product_id = ?
         ORDER BY is_primary DESC, sort_order ASC, id ASC'
    );
    $stmt->execute([$productId]);
    $images = $stmt->fetchAll(PDO::FETCH_ASSOC) ?: [];

    if (!$images) {
        throw new InvalidArgumentException('This product has no images to reorder.');
    }

    $rows = [];
    foreach ($images as $image) {
        $imageId = (int) $image['id'];
        $submitted = $submittedPositions[$imageId] ?? null;
        $position = is_numeric($submitted)
            ? (int) $submitted
            : ((int) $image['sort_order'] > 0 ? (int) $image['sort_order'] : PHP_INT_MAX);

        if ($position < 1) {
            $position = PHP_INT_MAX;
        }

        $rows[] = [
            'id' => $imageId,
            'is_primary' => (int) $image['is_primary'] === 1,
            'requested_position' => $position,
        ];
    }

    usort($rows, static function (array $a, array $b): int {
        if ($a['is_primary'] !== $b['is_primary']) {
            return $a['is_primary'] ? -1 : 1;
        }

        $positionCompare = $a['requested_position'] <=> $b['requested_position'];
        if ($positionCompare !== 0) {
            return $positionCompare;
        }

        return $a['id'] <=> $b['id'];
    });

    $update = $db->prepare(
        'UPDATE shop_product_images
         SET sort_order = ?
         WHERE id = ? AND product_id = ?'
    );

    $db->beginTransaction();
    try {
        foreach ($rows as $index => $row) {
            $update->execute([$index + 1, (int) $row['id'], $productId]);
        }

        if (function_exists('admin_users_audit')) {
            admin_users_audit(
                $db,
                $actorUserId,
                null,
                'shop.product_images_reordered',
                'Reordered product images for "' . (string) $product['name'] . '".',
                [
                    'product_id' => $productId,
                    'image_count' => count($rows),
                    'image_order' => array_map(static fn(array $row): int => (int) $row['id'], $rows),
                ]
            );
        }

        $db->commit();
        return count($rows);
    } catch (Throwable $exception) {
        if ($db->inTransaction()) {
            $db->rollBack();
        }
        throw $exception;
    }
}
