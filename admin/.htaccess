Options -Indexes

DirectoryIndex index.php

<IfModule mod_headers.c>

    # Admin must never appear in search results.
    Header always set X-Robots-Tag "noindex, nofollow,noarchive"

    # Browser security baseline.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Strict-Transport-Security "max-age=31536000"

</IfModule>


# FCC background workers continue after the short Admin response is
# returned to Safari. Do not kill V1 or V2 workers when the browser
# closes, reloads, changes tabs, or drops the request.
<IfModule LiteSpeed>
    RewriteEngine On
    RewriteRule ^cell-coverage-(sync|v2-api)\.php$ - [E=noabort:1,E=noconntimeout:1]
</IfModule>


# Central Llama Scout safety pages.

ErrorDocument 400 https://llamascout.com/safety.php?reason=400
ErrorDocument 401 https://llamascout.com/safety.php?reason=401
ErrorDocument 403 https://llamascout.com/safety.php?reason=403
ErrorDocument 404 https://llamascout.com/safety.php?reason=404
ErrorDocument 410 https://llamascout.com/safety.php?reason=410
ErrorDocument 429 https://llamascout.com/safety.php?reason=429
ErrorDocument 500 https://llamascout.com/safety.php?reason=500
ErrorDocument 503 https://llamascout.com/safety.php?reason=503
